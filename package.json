{
  "name": "peques-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "node scripts/build-icons.mjs && NEXT_TELEMETRY_DISABLED=1 next build --webpack && node scripts/complete-precache.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@serwist/next": "9.5.12",
    "dexie": "4.4.4",
    "motion": "12.42.2",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.5",
    "serwist": "9.5.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@5.0.7": "5.0.9",
      "browserslist@4.28.6": "4.28.7",
      "js-yaml@4.3.0": "4.3.1",
      "nanoid@3.3.16": "3.3.18",
      "postcss@8.4.31": "8.5.23",
      "postcss@8.5.19": "8.5.23"
    }
  }
}
